# ---------------------------------------------------------------------------
# F.A.C. V2 firmware - STM32CubeIDE (Eclipse CDT) project, STM32F072CBT6
#
# What stays tracked on purpose:
#   .project .cproject .mxproject  - IDE project definition
#   FAC_Firmware_V2.ioc            - CubeMX configuration (source of truth)
#   STM32F072CBTX_FLASH.ld         - linker script
#   *.launch                       - debug/run configurations
#   .settings/                     - IDE per project preferences
# ---------------------------------------------------------------------------

# --- Build output ----------------------------------------------------------
# Fully regenerated by STM32CubeIDE on every build. The generated makefiles
# (Debug/makefile, Debug/**/subdir.mk) embed absolute paths, so they are only
# valid on the machine that produced them.
/Debug/
/Release/

# Object files and build products anywhere else (out of tree or manual builds)
*.o
*.obj
*.d
*.su
*.cyclo
*.elf
*.bin
*.hex
*.srec
*.map
*.list
*.lss
*.a
*.gcno
*.gcda

# --- Eclipse / STM32CubeIDE workspace state --------------------------------
.metadata/
RemoteSystemsTempFiles/
.autotools
*.launch.bak

# --- CubeMX ----------------------------------------------------------------
# Backups written next to the .ioc when the code is regenerated
*.ioc.bak
*.ioc.old
.mxproject.bak

# --- Editors / IDEs --------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# --- OS junk ---------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# --- Misc ------------------------------------------------------------------
*.log
*.stackdump
