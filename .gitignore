# ---------------------------------------------------------------------------
# F.A.C. V2 firmware - STM32CubeIDE (Eclipse CDT) project, STM32F072CBT6
#
# What stays tracked on purpose:
#   .project .cproject .mxproject  - IDE project definition
#   FAC_Firmware_V2.ioc            - CubeMX configuration (source of truth)
#   STM32F072CBTX_FLASH.ld         - linker script
#   .settings/                     - IDE per project preferences
#   CMakeLists.txt CMakePresets.json cmake/  - CMake build (VS Code)
#   .vscode/launch.json .vscode/extensions.json
#
# NOT tracked: debug/run configurations (*.launch, *.cfg), see the bottom.
# ---------------------------------------------------------------------------

# --- Build output ----------------------------------------------------------
# Fully regenerated by STM32CubeIDE on every build. The generated makefiles
# (Debug/makefile, Debug/**/subdir.mk) embed absolute paths, so they are only
# valid on the machine that produced them.
/Debug/
/Release/
# CMake build tree (VS Code / STM32Cube extension), one folder per preset
/build/

# Object files and build products anywhere else (out of tree or manual builds)
*.o
*.obj
*.d
*.su
*.cyclo
*.elf
*.bin
*.hex
*.srec
*.map
*.list
*.lss
*.a
*.gcno
*.gcda

# --- Eclipse / STM32CubeIDE workspace state --------------------------------
.metadata/
RemoteSystemsTempFiles/
.autotools
*.launch.bak

# --- CubeMX ----------------------------------------------------------------
# Backups written next to the .ioc when the code is regenerated
*.ioc.bak
*.ioc.old
.mxproject.bak

# --- Editors / IDEs --------------------------------------------------------
# VS Code: only the shared, machine independent files are tracked
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.code-workspace
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# --- OS junk ---------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# --- Misc ------------------------------------------------------------------
*.log
*.stackdump

# --- Personal debug configurations -----------------------------------------
# A .launch pins the serial number of one specific ST-LINK and embeds absolute
# paths of one machine, so it is useless (and fails to find the probe) on any
# other setup. Each developer keeps their own; CubeIDE recreates a default one
# from Run > Debug Configurations.
*.launch
*.cfg
.clangd
.settings/bundles-lock.store.json
.settings/bundles.store.json
